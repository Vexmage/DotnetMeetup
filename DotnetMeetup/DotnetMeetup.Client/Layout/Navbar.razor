@using Microsoft.AspNetCore.Components.Routing

<header class="publication-header">
    <div class="editorial-container">
        <div class="publication-header__masthead">
            <a class="publication-header__brand" href="/">
                <img src="images/eugdotnet-seal.svg" alt="" width="48" height="48" />
                <span>EugDotNet</span>
            </a>
            <p class="publication-header__descriptor">Technology, Engineering &amp; Community</p>
            <p class="publication-header__location">Eugene, Oregon</p>
        </div>

        <nav aria-label="Primary">
            <ul class="publication-header__links">
                <li><NavLink href="/" Match="NavLinkMatch.All">Home</NavLink></li>
                <li><NavLink href="/events" Match="NavLinkMatch.All">Events</NavLink></li>
                <li><NavLink href="/shared-resources" Match="NavLinkMatch.All">Resources</NavLink></li>
                <li><NavLink href="/contribute" Match="NavLinkMatch.All">Contribute</NavLink></li>
                <li><a href="https://github.com/Dfreem/DotnetMeetup">GitHub</a></li>
                <li><NavLink href="/Account/Login" Match="NavLinkMatch.All">Log in</NavLink></li>
            </ul>
        </nav>
    </div>
</header>
